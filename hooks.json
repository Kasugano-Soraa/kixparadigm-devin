{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" pre", "timeout": 15 }
      ]
    },
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" pre", "timeout": 10 }
      ]
    },
    {
      "matcher": "^mcp__github__",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" pre", "timeout": 10 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(exec|write|edit|apply_patch|run_subagent)$",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" post", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" stop", "timeout": 10 }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$HOME/.config/devin}/hooks/kix_guards.py\" session", "timeout": 10 }
      ]
    }
  ]
}
